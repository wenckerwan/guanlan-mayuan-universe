# Copy to .env; use your own values. Never commit secrets.
MAYUAN_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Exact external HTTPS origin, no trailing slash; comma-separated if needed.
MAYUAN_ORIGINS=https://your-mayuan-domain.example
# Trusted Guanlan origin. Identity validation requires a real working auth/me.
GUANLAN_BASE_URL=
# Enable only after Guanlan implements and verifies this future summary protocol.
GUANLAN_SUMMARY_PROTOCOL=
GUANLAN_SUMMARY_URL=
GUANLAN_SERVICE_TOKEN=
